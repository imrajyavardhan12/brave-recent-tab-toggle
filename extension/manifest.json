{
  "manifest_version": 3,
  "name": "Recent Tab Toggle",
  "version": "0.1.0",
  "description": "Toggle between the two most recently active tabs in Brave.",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": ["nativeMessaging"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Recent Tab Toggle status",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-recent-tab": {
      "description": "Toggle the two most recently active tabs"
    }
  }
}
